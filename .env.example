PORT=3000
CORS_ORIGIN=*
NOMOS_BASE_URL=https://college-nomos.ru

# LLM Provider Configuration
# LLM_PROVIDER: "external" for OpenAI-compatible API, "ollama" for local Ollama
LLM_PROVIDER=external

# LLM_TIMEOUT: Timeout in seconds for LLM requests (default: 60)
LLM_TIMEOUT=60

# External Provider (Google Gemini Native API)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_API_KEY=your_api_key_here
LLM_MODEL=gemini-2.5-flash

# Ollama Provider (local, optional - used when LLM_PROVIDER=ollama)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
